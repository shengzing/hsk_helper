{
    "name": "@hsk-helper/server",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "extract:docs": "node --import tsx scripts/extract-docs-data.ts",
        "import:docs": "node --import tsx scripts/import-docs-data.ts",
        "build": "tsc -p tsconfig.json && cp src/db/*.sql dist/db/",
        "start": "node dist/server.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "generate:explanations": "node --import tsx scripts/generate-explanations.ts"
    },
    "dependencies": {
        "better-sqlite3": "^11.10.0",
        "cors": "^2.8.5",
        "express": "^4.21.2",
        "pdf-parse": "^2.4.5",
        "zod": "^3.25.0"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.12",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^22.0.0",
        "@types/supertest": "^6.0.0",
        "supertest": "^7.0.0",
        "tsx": "^4.19.2",
        "typescript": "^5.6.0",
        "vitest": "^3.2.7"
    }
}
